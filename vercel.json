{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/guardian.js": {
      "maxDuration": 60,
      "includeFiles": "{quality-guard.cjs,package.json,.gitignore,README.md,api/**,lib/**,municipios/**,pages/**,provincias/**,servicios/**,talleres/**,templates/**,css/**,js/**,scripts/**}"
    },
    "api/seo-audit.js": {
      "maxDuration": 60,
      "includeFiles": "{seo-auditor-global.cjs,index.html,desguaces.html,municipios/**,pages/**,provincias/**,servicios/**,talleres/**,desguace/**}"
    },
    "api/seo-fix-save.js": {
      "maxDuration": 60,
      "includeFiles": "{seo-auditor-global.cjs,index.html,desguaces.html,municipios/**,pages/**,provincias/**,servicios/**,talleres/**,desguace/**}"
    }
  },
  "redirects": [
    {
      "source": "/municipios/index.html",
      "destination": "https://www.tallermap.es/municipios/",
      "permanent": true
    },
    {
      "source": "/municipios/:slug.html",
      "destination": "https://www.tallermap.es/municipios/:slug",
      "permanent": true
    },
    {
      "source": "/servicios/index.html",
      "destination": "https://www.tallermap.es/servicios/",
      "permanent": true
    },
    {
      "source": "/provincias/index.html",
      "destination": "https://www.tallermap.es/provincias/",
      "permanent": true
    },
    {
      "source": "/talleres.html",
      "destination": "https://www.tallermap.es/provincias/",
      "permanent": true
    },
    {
      "source": "/talleres/:slug.html",
      "destination": "https://www.tallermap.es/talleres/:slug",
      "permanent": true
    },
    {
      "source": "/desguaces.html",
      "destination": "https://www.tallermap.es/desguaces",
      "permanent": true
    },
    {
      "source": "/desguace/:slug/index.html",
      "destination": "https://www.tallermap.es/desguace/:slug",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "https://www.tallermap.es/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{"type":"host","value":"tallermap.es"}],
      "destination": "https://www.tallermap.es/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {"source":"/municipios","destination":"/api/municipios-index"},
    {"source":"/municipios/","destination":"/api/municipios-index"},
    {"source":"/municipios/:slug","destination":"/api/municipio?archivo=:slug.html"},
    {"source":"/pages/taller.html","destination":"/api/taller-legacy"},
    {"source":"/","destination":"/api/home-cache-fix"},
    {"source":"/desguaces","destination":"/api/desguaces-seo"},
    {"source":"/provincias/alicante.html","destination":"/api/provincia-public?provincia=alicante"},
    {"source":"/provincias/castellon.html","destination":"/api/provincia-public?provincia=castellon"},
    {"source":"/provincias/valencia.html","destination":"/api/provincia-public?provincia=valencia"},
    {"source":"/talleres/:slug","destination":"/talleres/:slug/index.html"},
    {"source":"/desguace/:slug","destination":"/api/desguace-public?slug=:slug"},
    {"source":"/servicios/:servicio.html","destination":"/api/servicio-public?servicio=:servicio"},
    {"source":"/robots.txt","destination":"/api/robots"},
    {"source":"/sitemap-talleres.xml","destination":"/api/sitemap-talleres"},
    {"source":"/sitemap-municipios.xml","destination":"/api/sitemap-municipios"},
    {"source":"/sitemap-desguaces.xml","destination":"/api/sitemap-desguaces"}
  ],
  "headers": [
    {"source":"/(.*)","headers":[{"key":"Content-Security-Policy","value":"default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://www.googletagmanager.com https://www.google-analytics.com; script-src-elem 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://unpkg.com https://fonts.googleapis.com; img-src 'self' data: blob: https://*.supabase.co https://*.tile.openstreetmap.org https://unpkg.com https://www.googletagmanager.com https://www.google-analytics.com; connect-src 'self' https://cnyptelvbsndpkzbrete.supabase.co wss://cnyptelvbsndpkzbrete.supabase.co https://api.zippopotam.us https://nominatim.openstreetmap.org https://overpass-api.de https://overpass.private.coffee https://maps.mail.ru https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com; font-src 'self' data: https://fonts.gstatic.com; frame-src 'self' https://www.googletagmanager.com; manifest-src 'self'; upgrade-insecure-requests"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"X-Frame-Options","value":"DENY"},{"key":"Cross-Origin-Opener-Policy","value":"same-origin"},{"key":"Strict-Transport-Security","value":"max-age=63072000; includeSubDomains; preload"},{"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=(self), payment=()"}]},
    {"source":"/(css|js)/(.*)","missing":[{"type":"query","key":"v"}],"headers":[{"key":"Cache-Control","value":"public, max-age=3600, stale-while-revalidate=86400"}]},
    {"source":"/(css|js)/(.*)","has":[{"type":"query","key":"v"}],"headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source":"/images/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=604800, stale-while-revalidate=2592000"}]},
    {"source":"/(favicon.ico|favicon.svg|apple-touch-icon.png|site.webmanifest)","headers":[{"key":"Cache-Control","value":"public, max-age=604800, stale-while-revalidate=2592000"}]},
    {"source":"/sitemap.xml","headers":[{"key":"Content-Type","value":"application/xml; charset=utf-8"},{"key":"Cache-Control","value":"public, max-age=3600, stale-while-revalidate=86400"}]},
    {"source":"/sitemap-index.xml","headers":[{"key":"Content-Type","value":"application/xml; charset=utf-8"},{"key":"Cache-Control","value":"public, max-age=3600, stale-while-revalidate=86400"}]},
    {"source":"/sitemap-provincias.xml","headers":[{"key":"Content-Type","value":"application/xml; charset=utf-8"},{"key":"Cache-Control","value":"public, max-age=3600, stale-while-revalidate=86400"}]},
    {"source":"/sitemap-talleres.xml","headers":[{"key":"Content-Type","value":"application/xml; charset=utf-8"},{"key":"Cache-Control","value":"public, max-age=3600, stale-while-revalidate=86400"}]},
    {"source":"/sitemap-municipios.xml","headers":[{"key":"Content-Type","value":"application/xml; charset=utf-8"},{"key":"Cache-Control","value":"public, max-age=3600, stale-while-revalidate=86400"}]},
    {"source":"/sitemap-desguaces.xml","headers":[{"key":"Content-Type","value":"application/xml; charset=utf-8"},{"key":"Cache-Control","value":"public, max-age=3600, stale-while-revalidate=86400"}]},
    {"source":"/servicios/sitemap.xml","headers":[{"key":"Content-Type","value":"application/xml; charset=utf-8"},{"key":"Cache-Control","value":"public, max-age=3600, stale-while-revalidate=86400"}]},
    {"source":"/robots.txt","headers":[{"key":"Content-Type","value":"text/plain; charset=utf-8"},{"key":"Cache-Control","value":"public, max-age=3600, stale-while-revalidate=86400"}]}
  ]
}
