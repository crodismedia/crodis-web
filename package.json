{
  "private": true,
  "type": "module",
  "scripts": {
    "generate:municipios": "node scripts/generate-static-municipios.mjs",
    "validate": "node scripts/validate-site.mjs && node scripts/validate-step-1.mjs && node scripts/validate-step-2.mjs && node scripts/validate-step-3.mjs && node scripts/validate-step-4.mjs && node scripts/validate-html-first-taller.mjs",
    "diagnostico-alt": "node diagnostico-alt.js",
    "diagnostico-alt:prod": "node diagnostico-alt.js https://www.tallermap.es",
    "diagnostico-alt:local": "node diagnostico-alt.js http://localhost:3000",
    "verify-alt": "node diagnostico-alt.js https://www.tallermap.es",
    "verify-alt:vercel": "bash vercel-verify.sh https://www.tallermap.es",
    "quality": "node quality-guard.cjs",
    "quality:watch": "node quality-guard.cjs --watch",
    "quality:fix": "node quality-guard.cjs --fix",
    "quality:ci": "node quality-guard.cjs --ci",
    "quality:report": "node quality-guard.cjs --report",
    "quality:help": "node quality-guard.cjs --help",
    "quality:full": "npm run quality && npm run quality:report && npm run quality:fix && npm run quality && npm run quality:ci",
    "guardian:v2": "node scripts/guardian-v2.mjs",
    "guardian:v2:strict": "node scripts/guardian-v2.mjs --strict",
    "audit:seo:v2": "node scripts/deep-seo-audit.mjs --url=https://www.tallermap.es --max-pages=0 --concurrency=12",
    "audit:seo:v2:strict": "node scripts/deep-seo-audit.mjs --url=https://www.tallermap.es --max-pages=0 --concurrency=12 --strict",
    "audit:deep": "npm run guardian:v2 && npm run audit:seo:v2"
  },
  "dependencies": {
    "@vercel/functions": "latest",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "supabase": "^2.115.0"
  }
}
